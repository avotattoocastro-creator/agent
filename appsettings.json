{
  "AvoAgent": {
    "Port":       8181,
    "Token":      "change-me",
    "PhysicsHz":  60,
    "GraphicsHz": 20,
    "StaticHz":   1,
    "Setup": {
      "DefaultRoot": ""
    },
    "Discovery": {
      "Enabled":    true,
      "Port":       8182,
      "IntervalMs": 2000
    },
    "AdminUi": {
      "BindLocalhostOnly": true,
      "AllowRemote":       false
    },
    "Agent": {
      "AllowAutostartOperations": true,
      "AutoStartStreaming":       true,
      "AutoStopWhenAcCloses":     false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default":              "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
